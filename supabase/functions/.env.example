# Secrets for Supabase Edge Functions.
#
# THIS FILE IS A TEMPLATE. The real file (supabase/functions/.env) is gitignored
# and must stay that way — `.gitignore` line 34 covers it, verified.
#
# These values never reach the app. Edge Functions run on Supabase's servers,
# and nothing here is bundled into the client. That separation is the entire
# reason the Stripe integration is shaped this way; see SECURITY.md.
#
# Push them to the project with:
#   supabase secrets set --env-file supabase/functions/.env --project-ref <ref>
# or paste them in the dashboard under Edge Functions > Secrets.

# Stripe SECRET key (sk_test_... in test mode, sk_live_... in production).
# Full read/write on your Stripe account: it can charge cards, move money, issue
# refunds and read every customer. Treat a leak as an incident, not a chore.
STRIPE_SECRET_KEY=

# Stripe WEBHOOK signing secret (whsec_...).
# Created when you add the webhook endpoint in the Stripe dashboard, and shown
# only once. Without it the webhook handler fails closed and refuses every
# event — deliberately, because an unverifiable webhook is worth less than none:
# any stranger could otherwise POST "payment_intent.succeeded" and mark a job
# paid.
STRIPE_WEBHOOK_SECRET=

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform.
# Do not set them here.
